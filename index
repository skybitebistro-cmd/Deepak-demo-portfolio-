<title>Bioinformatics Portfolio | [Your Name]</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;800&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg:       #050d1a;
    --bg2:      #081422;
    --bg3:      #0a1d30;
    --teal:     #00e5cc;
    --cyan:     #00b4d8;
    --red:      #e63946;
    --text:     #d4e8f5;
    --muted:    #6a90aa;
    --border:   rgba(0,229,204,0.15);
    --card:     rgba(8,20,34,0.85);
    --glow:     0 0 30px rgba(0,229,204,0.12);
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Syne', sans-serif;
    background: var(--bg);
    color: var(--text);
    overflow-x: hidden;
    line-height: 1.7;
  }

  /* ─── NOISE OVERLAY ─── */
  body::before {
    content: '';
    position: fixed; inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none; z-index: 0; opacity: 0.4;
  }

  /* ─── HERO ─── */
  .hero {
    position: relative; min-height: 100vh;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 2rem;
    background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(0,180,216,0.07) 0%, transparent 70%),
                radial-gradient(ellipse 40% 50% at 80% 80%, rgba(0,229,204,0.05) 0%, transparent 60%),
                var(--bg);
    overflow: hidden;
  }

  /* DNA helix animated background */
  .helix-bg {
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(90deg, transparent, transparent 49px, rgba(0,229,204,0.03) 50px),
      repeating-linear-gradient(0deg,  transparent, transparent 49px, rgba(0,229,204,0.03) 50px);
    animation: gridshift 20s linear infinite;
  }
  @keyframes gridshift { to { background-position: 50px 50px; } }

  .hero-inner {
    position: relative; z-index: 1;
    text-align: center; max-width: 800px;
  }

  .avatar-wrap {
    width: 130px; height: 130px; margin: 0 auto 1.5rem;
    border-radius: 50%;
    border: 2px solid var(--teal);
    box-shadow: 0 0 40px rgba(0,229,204,0.3), 0 0 80px rgba(0,229,204,0.1);
    overflow: hidden;
    background: var(--bg3);
    display: flex; align-items: center; justify-content: center;
    font-size: 3.5rem;
  }

  .tag {
    display: inline-block;
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem; letter-spacing: 0.15em;
    color: var(--teal); text-transform: uppercase;
    border: 1px solid var(--border);
    border-radius: 2px; padding: 0.3rem 0.8rem;
    margin-bottom: 1.2rem;
    background: rgba(0,229,204,0.04);
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 800; line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1.2rem;
  }
  .hero h1 span { color: var(--teal); }

  .hero p {
    font-size: 1.05rem; color: var(--muted);
    max-width: 600px; margin: 0 auto 2rem;
  }

  .btn-row {
    display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  .btn {
    display: inline-block; padding: 0.75rem 1.8rem;
    font-family: 'Space Mono', monospace; font-size: 0.8rem;
    letter-spacing: 0.05em; text-decoration: none;
    border-radius: 3px; transition: all 0.25s;
    cursor: pointer;
  }
  .btn-primary {
    background: var(--teal); color: var(--bg);
    font-weight: 700; border: none;
  }
  .btn-primary:hover { background: #00ffdf; box-shadow: 0 0 20px rgba(0,229,204,0.4); }
  .btn-outline {
    background: transparent; color: var(--teal);
    border: 1px solid var(--teal);
  }
  .btn-outline:hover { background: rgba(0,229,204,0.07); }

  .pills {
    display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center;
  }
  .pill {
    font-family: 'Space Mono', monospace; font-size: 0.65rem;
    padding: 0.3rem 0.75rem; border-radius: 100px;
    background: rgba(0,180,216,0.08);
    border: 1px solid rgba(0,180,216,0.25);
    color: var(--cyan); letter-spacing: 0.05em;
  }

  /* ─── SCROLL INDICATOR ─── */
  .scroll-hint {
    position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center;
    gap: 0.4rem; color: var(--muted);
    font-family: 'Space Mono', monospace; font-size: 0.65rem;
    letter-spacing: 0.1em; animation: bounce 2s infinite;
  }
  .scroll-hint svg { opacity: 0.5; }
  @keyframes bounce { 0%,100%{transform:translateX(-50%) translateY(0)} 50%{transform:translateX(-50%) translateY(6px)} }

  /* ─── SECTIONS ─── */
  section { position: relative; z-index: 1; padding: 5rem 1.5rem; }
  .container { max-width: 1100px; margin: 0 auto; }

  .section-label {
    font-family: 'Space Mono', monospace;
    font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--teal); margin-bottom: 0.6rem;
  }
  h2.section-title {
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    font-weight: 800; line-height: 1.1;
    letter-spacing: -0.02em; margin-bottom: 1rem;
  }
  .section-desc { color: var(--muted); max-width: 600px; margin-bottom: 3rem; }

  /* ─── ABOUT / SKILLS ─── */
  .about-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 3rem;
    align-items: start;
  }
  @media(max-width:700px){ .about-grid{grid-template-columns:1fr;} }

  .skill-bars { display: flex; flex-direction: column; gap: 1rem; }
  .skill-item label {
    display: flex; justify-content: space-between;
    font-family: 'Space Mono', monospace; font-size: 0.75rem;
    color: var(--text); margin-bottom: 0.4rem;
  }
  .skill-item label span { color: var(--teal); }
  .bar-track {
    height: 5px; background: rgba(255,255,255,0.06);
    border-radius: 10px; overflow: hidden;
  }
  .bar-fill {
    height: 100%; border-radius: 10px;
    background: linear-gradient(90deg, var(--teal), var(--cyan));
    animation: fillbar 1.5s ease forwards;
    transform-origin: left;
  }
  @keyframes fillbar { from{width:0} }

  .about-text p { color: var(--muted); margin-bottom: 1rem; }
  .about-text strong { color: var(--text); }

  .disclaimer-box {
    margin-top: 1.5rem;
    padding: 1rem 1.2rem;
    border-left: 3px solid var(--teal);
    background: rgba(0,229,204,0.04);
    border-radius: 0 4px 4px 0;
    font-size: 0.88rem; color: var(--muted);
  }
  .disclaimer-box strong { color: var(--teal); display: block; margin-bottom: 0.3rem; }

  /* ─── PROJECTS ─── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .project-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.6rem;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
    position: relative; overflow: hidden;
  }
  .project-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, var(--teal), var(--cyan));
    opacity: 0; transition: opacity 0.3s;
  }
  .project-card:hover { transform: translateY(-4px); box-shadow: var(--glow); border-color: rgba(0,229,204,0.3); }
  .project-card:hover::before { opacity: 1; }

  .project-num {
    font-family: 'Space Mono', monospace; font-size: 0.65rem;
    color: var(--teal); letter-spacing: 0.1em; margin-bottom: 0.75rem;
    opacity: 0.7;
  }
  .project-card h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 0.5rem; }
  .project-card p { font-size: 0.88rem; color: var(--muted); margin-bottom: 1.2rem; }

  .project-meta {
    display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.2rem;
  }
  .badge {
    font-family: 'Space Mono', monospace; font-size: 0.6rem;
    padding: 0.25rem 0.6rem;
    border-radius: 3px;
    background: rgba(0,180,216,0.08);
    border: 1px solid rgba(0,180,216,0.2);
    color: var(--cyan); letter-spacing: 0.04em;
  }

  .project-footer {
    display: flex; justify-content: space-between; align-items: center;
  }
  .complexity { font-size: 0.75rem; color: var(--muted); }
  .status-badge {
    font-family: 'Space Mono', monospace; font-size: 0.6rem;
    padding: 0.25rem 0.7rem; border-radius: 100px;
  }
  .status-done { background: rgba(0,229,204,0.1); color: var(--teal); border: 1px solid rgba(0,229,204,0.3); }
  .status-wip  { background: rgba(230,57,70,0.1);  color: var(--red);  border: 1px solid rgba(230,57,70,0.3); }

  .project-link {
    display: block; text-align: center; margin-top: 1rem;
    padding: 0.55rem; border: 1px solid var(--border);
    border-radius: 4px; font-family: 'Space Mono', monospace;
    font-size: 0.7rem; color: var(--teal); text-decoration: none;
    transition: all 0.2s;
    letter-spacing: 0.05em;
  }
  .project-link:hover { background: rgba(0,229,204,0.07); border-color: var(--teal); }

  /* ─── ROADMAP ─── */
  .roadmap { display: flex; flex-direction: column; gap: 0; }
  .road-item {
    display: flex; align-items: flex-start; gap: 1.2rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .road-dot {
    width: 14px; height: 14px; border-radius: 50%; flex-shrink: 0;
    margin-top: 0.3rem;
  }
  .road-dot.done  { background: var(--teal); box-shadow: 0 0 10px rgba(0,229,204,0.5); }
  .road-dot.now   { background: var(--cyan); animation: pulse 1.5s infinite; }
  .road-dot.plan  { background: transparent; border: 2px solid var(--muted); }
  @keyframes pulse { 0%,100%{box-shadow:0 0 0 0 rgba(0,180,216,0.4)} 50%{box-shadow:0 0 0 8px rgba(0,180,216,0)} }

  .road-text strong { color: var(--text); font-size: 0.92rem; }
  .road-text span   { color: var(--muted); font-size: 0.78rem; display: block; }

  /* ─── SERVICES ─── */
  .services-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.2rem; }
  .service-card {
    padding: 1.4rem;
    background: var(--card); border: 1px solid var(--border);
    border-radius: 8px;
  }
  .service-icon { font-size: 1.8rem; margin-bottom: 0.7rem; }
  .service-card h4 { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.4rem; }
  .service-card p { font-size: 0.82rem; color: var(--muted); margin-bottom: 0.7rem; }
  .price-range { font-family: 'Space Mono', monospace; font-size: 0.75rem; color: var(--teal); }

  /* ─── CONTACT ─── */
  .contact-section {
    background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(0,180,216,0.06) 0%, transparent 70%);
    text-align: center; padding: 5rem 1.5rem;
  }
  .contact-links { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 2rem; }

  /* ─── NAV ─── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; justify-content: space-between; align-items: center;
    padding: 1rem 2rem;
    background: rgba(5,13,26,0.85); backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav-logo { font-family: 'Space Mono', monospace; color: var(--teal); font-size: 0.9rem; text-decoration: none; }
  .nav-links { display: flex; gap: 1.5rem; list-style: none; }
  .nav-links a {
    font-size: 0.8rem; text-decoration: none; color: var(--muted);
    transition: color 0.2s;
    font-family: 'Space Mono', monospace; letter-spacing: 0.03em;
  }
  .nav-links a:hover { color: var(--teal); }
  @media(max-width:600px){ .nav-links { display:none; } }

  /* ─── DIVIDER ─── */
  .divider { border: none; border-top: 1px solid var(--border); margin: 0; }

  /* ─── FOOTER ─── */
  footer {
    text-align: center; padding: 2.5rem 1rem;
    font-family: 'Space Mono', monospace; font-size: 0.7rem;
    color: var(--muted); border-top: 1px solid var(--border);
  }
  footer span { color: var(--teal); }

  /* ─── ANIMATIONS ─── */
  [data-reveal] { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
  [data-reveal].visible { opacity: 1; transform: none; }
</style>
</head>
