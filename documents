**⚙️ Complete Workflow & Commands**

```bash
# ============================
# SCRIPT 01: Download FASTQ
# File: scripts/01_download_fastq.sh
# ============================

#!/bin/bash
set -euo pipefail

# Configuration
ACCESSION="SRR390728"
OUTPUT_DIR="data/raw"

# Create directories
mkdir -p ${OUTPUT_DIR}

echo "Downloading ${ACCESSION} from SRA..."

# Method 1: SRA Toolkit (preferred)
prefetch ${ACCESSION}
fastq-dump --outdir ${OUTPUT_DIR} \
           --gzip \
           --skip-technical \
           --readids \
           --read-filter pass \
           --dumpbase \
           --split-3 \
           --clip \
           ${ACCESSION}

echo "Download complete. Files saved to ${OUTPUT_DIR}/"
ls -lh ${OUTPUT_DIR}/

# ============================
# SCRIPT 02: Run FastQC
# File: scripts/02_run_fastqc.sh
# ============================

#!/bin/bash
set -euo pipefail

INPUT_DIR="data/raw"
OUTPUT_DIR="results/fastqc_reports"
THREADS=4

mkdir -p ${OUTPUT_DIR}

echo "Running FastQC on all FASTQ files..."

fastqc \
  --outdir ${OUTPUT_DIR} \
  --threads ${THREADS} \
  --extract \
  ${INPUT_DIR}/*.fastq.gz

echo "FastQC complete. Reports in ${OUTPUT_DIR}/"

# ============================
# SCRIPT 03: Run MultiQC
# File: scripts/03_run_multiqc.sh
# ============================

#!/bin/bash
set -euo pipefail

INPUT_DIR="results/fastqc_reports"
OUTPUT_DIR="results"

echo "Aggregating QC reports with MultiQC..."

multiqc \
  ${INPUT_DIR} \
  --outdir ${OUTPUT_DIR} \
  --filename "multiqc_report" \
  --title "RNA-seq QC Report — SRR390728" \
  --comment "Portfolio project: self-directed learning"

echo "MultiQC report generated: ${OUTPUT_DIR}/multiqc_report.html"
```

---

**📊 Expected Outputs**

- `results/fastqc_reports/SRR390728_fastqc.html` — Interactive per-sample QC report
- `results/multiqc_report.html` — Aggregated summary (open in browser)
- Key metrics to examine:
  - Per-base sequence quality (Phred scores >30 = good)
  - Adapter content (should be low or absent)
  - GC content (should match organism expectation ~51% for E. coli)
