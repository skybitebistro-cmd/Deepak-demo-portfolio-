**⚙️ Complete R Scripts**

```r
# ============================
# SCRIPT 01: Heatmap
# File: scripts/01_heatmap.R
# ============================

library(DESeq2)
library(pheatmap)
library(RColorBrewer)
library(tidyverse)

# Load DESeq2 object from Project 02
dds <- readRDS("../project_02_differential_expression/results/dds_object.rds")

# Variance-stabilizing transformation for visualization
vsd <- vst(dds, blind = FALSE)

# Get top 50 most variable genes
rv <- rowVars(assay(vsd))
top50 <- order(rv, decreasing = TRUE)[1:50]

# Create annotation
annotation_col <- data.frame(
  Condition = colData(dds)$condition,
  row.names = colnames(dds)
)

# Color palettes
ann_colors <- list(
  Condition = c(control = "#4ECDC4", infected = "#E63946")
)

# Plot heatmap
png("results/heatmap_top50genes.png", width = 2800, height = 3200, res = 300)
pheatmap(
  assay(vsd)[top50, ],
  annotation_col = annotation_col,
  annotation_colors = ann_colors,
  color = colorRampPalette(rev(brewer.pal(11, "RdBu")))(100),
  scale = "row",
  show_rownames = TRUE,
  show_colnames = TRUE,
  fontsize_row = 6,
  fontsize_col = 8,
  main = "Top 50 Most Variable Genes\nGSE96870 — Infected vs Control",
  clustering_distance_rows = "euclidean",
  clustering_distance_cols = "euclidean",
  clustering_method = "ward.D2"
)
dev.off()

cat("Heatmap saved: results/heatmap_top50genes.png\n")

# ============================
# SCRIPT 02: PCA Plot
# File: scripts/02_pca_plot.R
# ============================

library(DESeq2)
library(ggplot2)
library(ggrepel)

dds <- readRDS("../project_02_differential_expression/results/dds_object.rds")
vsd <- vst(dds, blind = FALSE)

# PCA using DESeq2 built-in
pca_data <- plotPCA(vsd,
                    intgroup = "condition",
                    returnData = TRUE)

percent_var <- round(100 * attr(pca_data, "percentVar"), 1)

# Custom ggplot2 PCA
pca_plot <- ggplot(pca_data, aes(PC1, PC2,
                                  color = condition,
                                  label = name)) +
  geom_point(size = 5, alpha = 0.85) +
  geom_text_repel(size = 3, max.overlaps = 10) +
  scale_color_manual(values = c(control = "#4ECDC4", infected = "#E63946")) +
  labs(
    title = "PCA of RNA-seq Samples",
    subtitle = "GSE96870 — Variance-Stabilized Counts",
    x = paste0("PC1 (", percent_var[1], "% variance)"),
    y = paste0("PC2 (", percent_var[2], "% variance)"),
    color = "Condition"
  ) +
  theme_minimal(base_size = 14) +
  theme(
    plot.title = element_text(face = "bold"),
    legend.position = "right",
    panel.grid.minor = element_blank()
  )

ggsave("results/pca_samples.png",
       pca_plot,
       width = 10, height = 8, dpi = 300)

cat("PCA plot saved: results/pca_samples.png\n")

# ============================
# SCRIPT 03: Volcano Plot (standalone)
# File: scripts/03_volcano_plot.R
# ============================

library(ggplot2)
library(dplyr)

# Load DESeq2 results
res_df <- read.csv("../project_02_differential_expression/results/DEG_results_all.csv")

# Add significance category
res_df <- res_df %>%
  mutate(
    significance = case_when(
      padj < 0.05 & log2FoldChange > 1  ~ "Upregulated",
      padj < 0.05 & log2FoldChange < -1 ~ "Downregulated",
      TRUE                               ~ "Not significant"
    )
  ) %>%
  filter(!is.na(padj))  # remove NA rows

# Count DEGs
cat("Upregulated:", sum(res_df$significance == "Upregulated"), "\n")
cat("Downregulated:", sum(res_df$significance == "Downregulated"), "\n")

# Volcano plot with ggplot2
volcano <- ggplot(res_df, aes(x = log2FoldChange,
                               y = -log10(pvalue),
                               color = significance)) +
  geom_point(alpha = 0.5, size = 1.5) +
  scale_color_manual(values = c(
    "Upregulated"     = "#E63946",
    "Downregulated"   = "#00B4D8",
    "Not significant" = "grey70"
  )) +
  geom_vline(xintercept = c(-1, 1), linetype = "dashed", color = "black", alpha = 0.4) +
  geom_hline(yintercept = -log10(0.05), linetype = "dashed", color = "black", alpha = 0.4) +
  labs(
    title = "Volcano Plot — Infected vs Control",
    subtitle = "GSE96870 | DESeq2 | padj < 0.05, |log2FC| > 1",
    x = "log2 Fold Change",
    y = "-log10(p-value)",
    color = "Significance"
  ) +
  theme_minimal(base_size = 13) +
  theme(plot.title = element_text(face = "bold"))

ggsave("results/volcano_plot_ggplot.png",
       volcano, width = 10, height = 8, dpi = 300)

cat("Volcano plot saved.\n")
sessionInfo()
