```r
# ============================
# SCRIPT 01: Load Data
# File: scripts/01_load_data.R
# ============================

# Install packages if needed (run once)
# if (!require("BiocManager")) install.packages("BiocManager")
# BiocManager::install(c("DESeq2", "GEOquery", "EnhancedVolcano"))
# install.packages(c("tidyverse", "ggplot2"))

library(GEOquery)
library(tidyverse)

# Download GSE96870 from GEO
gse <- getGEO("GSE96870", GSEMatrix = TRUE)

# Extract phenotype data
pheno_data <- pData(gse[[1]])
print(head(pheno_data))

# NOTE: For count matrix, download supplementary files from GEO page:
# GSE96870_counts_mouse.txt.gz (available on GEO supplementary)

# Load count matrix
counts <- read.table("data/GSE96870_counts_mouse.txt.gz",
                     header = TRUE,
                     row.names = 1,
                     sep = "\t")

cat("Count matrix dimensions:", dim(counts), "\n")
cat("First few genes:\n")
print(head(counts[, 1:5]))

# ============================
# SCRIPT 02: DESeq2 Analysis
# File: scripts/02_deseq2_analysis.R
# ============================

library(DESeq2)
library(tidyverse)

# Load count matrix (from script 01)
counts <- read.table("data/GSE96870_counts_mouse.txt.gz",
                     header = TRUE,
                     row.names = 1,
                     sep = "\t")

# Create sample metadata
# Adjust column groupings based on actual sample names
col_data <- data.frame(
  sample = colnames(counts),
  condition = c(rep("control", 4), rep("infected", 4)),  # adjust as needed
  row.names = colnames(counts)
)

cat("Sample metadata:\n")
print(col_data)

# Ensure factor levels
col_data$condition <- factor(col_data$condition,
                              levels = c("control", "infected"))

# Create DESeq2 object
dds <- DESeqDataSetFromMatrix(
  countData = counts,
  colData = col_data,
  design = ~ condition
)

# Pre-filtering: remove very low count genes
keep <- rowSums(counts(dds) >= 10) >= 3
dds <- dds[keep, ]
cat("Genes after filtering:", nrow(dds), "\n")

# Run DESeq2
dds <- DESeq(dds)

# Get results
res <- results(dds,
               contrast = c("condition", "infected", "control"),
               alpha = 0.05)

# Summary
summary(res)

# Save R object
saveRDS(dds, "results/dds_object.rds")
saveRDS(res, "results/deseq2_results.rds")

# ============================
# SCRIPT 03: Export Results
# File: scripts/03_results_export.R
# ============================

library(DESeq2)
library(EnhancedVolcano)
library(tidyverse)

# Load saved results
res <- readRDS("results/deseq2_results.rds")

# Convert to data frame
res_df <- as.data.frame(res) %>%
  rownames_to_column("gene_id") %>%
  arrange(padj)

# Export all results
write.csv(res_df,
          "results/DEG_results_all.csv",
          row.names = FALSE)

# Export significant DEGs (padj < 0.05, |log2FC| > 1)
sig_degs <- res_df %>%
  filter(padj < 0.05, abs(log2FoldChange) > 1) %>%
  arrange(padj)

write.csv(sig_degs,
          "results/DEG_results_significant.csv",
          row.names = FALSE)

cat("Total significant DEGs:", nrow(sig_degs), "\n")
cat("Upregulated:", sum(sig_degs$log2FoldChange > 0), "\n")
cat("Downregulated:", sum(sig_degs$log2FoldChange < 0), "\n")

# Volcano plot
png("results/volcano_plot.png", width = 2400, height = 2000, res = 300)
EnhancedVolcano(res,
  lab = rownames(res),
  x = "log2FoldChange",
  y = "pvalue",
  title = "Infected vs Control — GSE96870",
  subtitle = "DESeq2 | padj < 0.05 | |log2FC| > 1",
  pCutoff = 0.05,
  FCcutoff = 1,
  pointSize = 2,
  labSize = 3,
  col = c("grey70", "grey70", "#00B4D8", "#E63946"),
  legendPosition = "right"
)
dev.off()

# Session info for reproducibility
cat("\n--- Session Info ---\n")
sessionInfo()
```

